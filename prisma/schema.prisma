// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum user_role {
  user
  store_admin
  super_admin
}

enum auth_provider {
  email
  google
  facebook
  twitter
}

enum order_status {
  waiting_for_payment
  waiting_for_confirmation
  processing
  shipped
  confirmed
  cancelled
}

enum payment_method {
  payment_gateway
}

enum discount_type {
  percentage
  nominal
  buy_one_get_one
}

enum voucher_type {
  product_specific
  total_purchase
  shipping
}

enum stock_journal_type {
  addition
  reduction
  mutation_in
  mutation_out
  order_deduction
  order_cancellation_return
}

enum stock_mutation_status {
  pending
  approved
  rejected
  completed
}

model User {
  id                  Int                  @id @default(autoincrement())
  first_name          String?              @db.VarChar(50)
  last_name           String?              @db.VarChar(50)
  email               String               @unique @db.VarChar(255)
  password            String?              @db.VarChar(255)
  phone               String?              @db.VarChar(20)
  profile_image          String?              @db.VarChar(255)
  profile_image_public_id String?             @db.VarChar(255)
  role                user_role            @default(user)
  is_verified         Boolean              @default(false)
  referral_code       String?              @unique @db.VarChar(20)
  referred_by_id      Int?
  created_at          DateTime             @default(now())
  updated_at          DateTime             @default(now())
  deleted_at          DateTime?

  referred_by         User?                @relation("UserReferral", fields: [referred_by_id], references: [id])
  referrals           User[]               @relation("UserReferral")
  user_oauth_accounts UserOAuthAccount[]
  verification_tokens VerificationToken[]
  user_addresses      UserAddress[]
  store_admins        StoreAdmin[]
  user_vouchers       UserVoucher[]
  cart                Cart?
  orders              Order[]

  @@map("users")
}

model UserOAuthAccount {
  id               Int           @id @default(autoincrement())
  user_id          Int
  provider         auth_provider
  provider_user_id String        @db.VarChar(255)
  provider_email   String?       @db.VarChar(255)
  access_token     String?       @db.Text
  refresh_token    String?       @db.Text
  token_expires_at DateTime?
  created_at       DateTime      @default(now())
  updated_at       DateTime      @default(now())
  deleted_at       DateTime?

  user             User          @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([provider, provider_user_id])
  @@map("user_oauth_accounts")
}

model VerificationToken {
  id         Int       @id @default(autoincrement())
  user_id    Int
  token      String    @unique @db.VarChar(255)
  type       String    @db.VarChar(20)
  is_used    Boolean   @default(false)
  expires_at DateTime
  created_at DateTime  @default(now())
  deleted_at DateTime?

  user       User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("verification_tokens")
}

model Province {
  id                     Int           @id @default(autoincrement())
  rajaongkir_province_id Int           @unique
  name                   String        @db.VarChar(100)
  created_at             DateTime      @default(now())
  updated_at             DateTime      @default(now())
  deleted_at             DateTime?

  cities                 City[]
  user_addresses         UserAddress[]
  stores                 Store[]

  @@map("provinces")
}

model City {
  id                 Int           @id @default(autoincrement())
  province_id        Int
  rajaongkir_city_id Int           @unique
  type               String?       @db.VarChar(20)
  name               String        @db.VarChar(100)
  postal_code        String?       @db.VarChar(10)
  created_at         DateTime      @default(now())
  updated_at         DateTime      @default(now())
  deleted_at         DateTime?

  province           Province      @relation(fields: [province_id], references: [id])
  districts          District[]
  user_addresses     UserAddress[]
  stores             Store[]

  @@map("cities")
}

model District {
  id                     Int           @id @default(autoincrement())
  city_id                Int
  rajaongkir_district_id Int           @unique
  name                   String        @db.VarChar(100)
  created_at             DateTime      @default(now())
  updated_at             DateTime      @default(now())
  deleted_at             DateTime?

  city                   City          @relation(fields: [city_id], references: [id])
  user_addresses         UserAddress[]
  stores                 Store[]

  @@map("districts")
}

model UserAddress {
  id                Int         @id @default(autoincrement())
  user_id           Int
  label             String?     @db.VarChar(50)
  recipient_name    String      @db.VarChar(100)
  phone             String      @db.VarChar(20)
  address           String      @db.Text
  district_id       Int
  city_id           Int
  province_id       Int
  postal_code       String?     @db.VarChar(10)
  latitude          Decimal     @db.Decimal(10, 7)
  longitude         Decimal     @db.Decimal(10, 7)
  geocode_provider  String?     @db.VarChar(50)
  geocoded_at       DateTime?
  geocoding_status  String?     @db.VarChar(20)
  is_primary        Boolean     @default(false)
  created_at        DateTime    @default(now())
  updated_at        DateTime    @default(now())
  deleted_at        DateTime?

  user              User        @relation(fields: [user_id], references: [id], onDelete: Cascade)
  province          Province    @relation(fields: [province_id], references: [id])
  city              City        @relation(fields: [city_id], references: [id])
  district          District    @relation(fields: [district_id], references: [id])
  orders            Order[]

  @@map("user_addresses")
}

model Store {
  id                           Int             @id @default(autoincrement())
  name                         String          @db.VarChar(100)
  address                      String          @db.Text
  district_id                  Int
  city_id                      Int
  province_id                  Int
  postal_code                  String?         @db.VarChar(10)
  latitude                     Decimal         @db.Decimal(10, 7)
  longitude                    Decimal         @db.Decimal(10, 7)
  max_delivery_distance        Decimal         @db.Decimal(10, 2)
  created_at                   DateTime        @default(now())
  updated_at                   DateTime        @default(now())
  deleted_at                   DateTime?

  province                     Province        @relation(fields: [province_id], references: [id])
  city                         City            @relation(fields: [city_id], references: [id])
  district                     District        @relation(fields: [district_id], references: [id])
  store_admins                 StoreAdmin[]
  store_inventories            StoreInventory[]
  source_stock_mutations       StockMutation[] @relation("StockMutationSourceStore")
  destination_stock_mutations  StockMutation[] @relation("StockMutationDestinationStore")
  discounts                    Discount[]
  carts                        Cart[]
  orders                       Order[]

  @@map("stores")
}

model StoreAdmin {
  id         Int       @id @default(autoincrement())
  store_id   Int
  user_id    Int
  created_at DateTime  @default(now())
  deleted_at DateTime?

  store      Store     @relation(fields: [store_id], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([store_id, user_id])
  @@map("store_admins")
}

model ProductCategory {
  id         Int       @id @default(autoincrement())
  name       String    @unique @db.VarChar(100)
  image_url  String?   @db.VarChar(255)
  public_id  String?   @db.VarChar(255)
  created_at DateTime  @default(now())
  updated_at DateTime  @default(now())
  deleted_at DateTime?

  products   Product[]

  @@map("product_categories")
}

model Product {
  id                Int              @id @default(autoincrement())
  name              String           @unique @db.VarChar(255)
  slug              String           @unique @db.VarChar(255)
  description       String?          @db.Text
  price             Decimal          @db.Decimal(12, 2)
  weight            Decimal          @db.Decimal(10, 2)
  category_id       Int
  created_at        DateTime         @default(now())
  updated_at        DateTime         @default(now())
  deleted_at        DateTime?

  category          ProductCategory  @relation(fields: [category_id], references: [id])
  product_images    ProductImage[]
  store_inventories StoreInventory[]
  stock_mutations   StockMutation[]
  discounts         Discount[]
  vouchers          Voucher[]
  cart_items        CartItem[]
  order_items       OrderItem[]

  @@map("products")
}

model ProductImage {
  id         Int       @id @default(autoincrement())
  product_id Int
  image_url  String    @db.VarChar(255)
  public_id  String?   @db.VarChar(255)
  is_primary Boolean   @default(false)
  created_at DateTime  @default(now())
  deleted_at DateTime?

  product    Product   @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@map("product_images")
}

model StoreInventory {
  id             Int            @id @default(autoincrement())
  store_id       Int
  product_id     Int
  stock          Int            @default(0)
  created_at     DateTime       @default(now())
  updated_at     DateTime       @default(now())
  deleted_at     DateTime?

  store          Store          @relation(fields: [store_id], references: [id], onDelete: Cascade)
  product        Product        @relation(fields: [product_id], references: [id], onDelete: Cascade)
  stock_journals StockJournal[]

  @@unique([store_id, product_id])
  @@map("store_inventories")
}

model StockJournal {
  id                 Int                @id @default(autoincrement())
  store_inventory_id Int
  quantity           Int
  type               stock_journal_type
  description        String?            @db.Text
  reference_id       Int?
  created_at         DateTime           @default(now())
  deleted_at         DateTime?

  store_inventory    StoreInventory     @relation(fields: [store_inventory_id], references: [id], onDelete: Cascade)

  @@map("stock_journals")
}

model StockMutation {
  id                   Int                   @id @default(autoincrement())
  source_store_id      Int
  destination_store_id Int
  product_id           Int
  quantity             Int
  status               stock_mutation_status @default(pending)
  created_at           DateTime              @default(now())
  updated_at           DateTime              @default(now())
  deleted_at           DateTime?

  source_store         Store                 @relation("StockMutationSourceStore", fields: [source_store_id], references: [id])
  destination_store    Store                 @relation("StockMutationDestinationStore", fields: [destination_store_id], references: [id])
  product              Product               @relation(fields: [product_id], references: [id])

  @@map("stock_mutations")
}

model Discount {
  id                  Int            @id @default(autoincrement())
  store_id            Int
  product_id          Int?
  type                discount_type
  value               Decimal?       @db.Decimal(12, 2)
  min_purchase_amount Decimal?       @db.Decimal(12, 2)
  max_discount_value  Decimal?       @db.Decimal(12, 2)
  is_active           Boolean        @default(true)
  started_at          DateTime?
  expired_at          DateTime?
  created_at          DateTime       @default(now())
  updated_at          DateTime       @default(now())
  deleted_at          DateTime?

  store               Store          @relation(fields: [store_id], references: [id], onDelete: Cascade)
  product             Product?       @relation(fields: [product_id], references: [id])
  order_items         OrderItem[]

  @@map("discounts")
}

model Voucher {
  id                  Int           @id @default(autoincrement())
  code                String        @unique @db.VarChar(50)
  discount_type       discount_type
  discount_value      Decimal       @db.Decimal(12, 2)
  max_discount_amount Decimal?      @db.Decimal(12, 2)
  min_purchase_amount Decimal?      @db.Decimal(12, 2)
  usage_type          voucher_type
  product_id          Int?
  is_referral         Boolean       @default(false)
  expired_at          DateTime
  created_at          DateTime      @default(now())
  updated_at          DateTime      @default(now())
  deleted_at          DateTime?

  product             Product?      @relation(fields: [product_id], references: [id])
  user_vouchers       UserVoucher[]
  orders              Order[]

  @@map("vouchers")
}

model UserVoucher {
  id         Int       @id @default(autoincrement())
  user_id    Int
  voucher_id Int
  is_used    Boolean   @default(false)
  used_at    DateTime?
  order_id   Int?
  created_at DateTime  @default(now())
  deleted_at DateTime?

  user       User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  voucher    Voucher   @relation(fields: [voucher_id], references: [id], onDelete: Cascade)
  order      Order?    @relation(fields: [order_id], references: [id])

  @@map("user_vouchers")
}

model Cart {
  id         Int       @id @default(autoincrement())
  user_id    Int       @unique
  store_id   Int
  created_at DateTime  @default(now())
  updated_at DateTime  @default(now())
  deleted_at DateTime?

  user       User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  store      Store     @relation(fields: [store_id], references: [id])
  cart_items CartItem[]

  @@map("carts")
}

model CartItem {
  id         Int       @id @default(autoincrement())
  cart_id    Int
  product_id Int
  quantity   Int       @default(1)
  created_at DateTime  @default(now())
  updated_at DateTime  @default(now())
  deleted_at DateTime?

  cart       Cart      @relation(fields: [cart_id], references: [id], onDelete: Cascade)
  product    Product   @relation(fields: [product_id], references: [id])

  @@unique([cart_id, product_id])
  @@map("cart_items")
}

model Order {
  id               Int            @id @default(autoincrement())
  user_id          Int
  store_id         Int
  order_number     String         @unique @db.VarChar(50)
  status           order_status   @default(waiting_for_payment)
  total_price      Decimal        @db.Decimal(12, 2)
  total_discount   Decimal        @default(0) @db.Decimal(12, 2)
  shipping_cost    Decimal        @default(0) @db.Decimal(12, 2)
  shipping_method  String?        @db.VarChar(50)
  address_id       Int
  voucher_id       Int?
  payment_method   payment_method
  payment_deadline DateTime?
  // Midtrans payment fields
  midtrans_order_id        String?   @db.VarChar(255)
  midtrans_transaction_id String?   @db.VarChar(255)
  midtrans_status         String?   @db.VarChar(50)
  payment_url             String?   @db.Text
  shipped_at       DateTime?
  confirmed_at     DateTime?
  cancelled_at     DateTime?
  created_at       DateTime       @default(now())
  updated_at       DateTime       @default(now())
  deleted_at       DateTime?

  user             User           @relation(fields: [user_id], references: [id])
  store            Store          @relation(fields: [store_id], references: [id])
  address          UserAddress    @relation(fields: [address_id], references: [id])
  voucher          Voucher?       @relation(fields: [voucher_id], references: [id])
  user_vouchers    UserVoucher[]
  order_items      OrderItem[]

  @@map("orders")
}

model OrderItem {
  id              Int       @id @default(autoincrement())
  order_id        Int
  product_id      Int
  quantity        Int
  price           Decimal   @db.Decimal(12, 2)
  discount_amount Decimal   @default(0) @db.Decimal(12, 2)
  discount_id     Int?
  is_bogo_item    Boolean   @default(false)
  total_price     Decimal   @db.Decimal(12, 2)
  created_at      DateTime  @default(now())
  deleted_at      DateTime?

  order           Order     @relation(fields: [order_id], references: [id], onDelete: Cascade)
  product         Product   @relation(fields: [product_id], references: [id])
  discount        Discount? @relation(fields: [discount_id], references: [id])

  @@map("order_items")
}

model ShippingCostCache {
  id                  Int      @id @default(autoincrement())
  origin_city_id      Int
  destination_city_id Int
  weight              Int
  courier             String   @db.VarChar(20)
  result              Json
  created_at          DateTime @default(now())
  expires_at          DateTime

  @@unique([origin_city_id, destination_city_id, weight, courier])
  @@map("shipping_cost_cache")
}

