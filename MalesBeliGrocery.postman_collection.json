{
  "info": {
    "name": "MalesBeliGrocery API",
    "_postman_id": "malesbeligrocery-api-v1",
    "description": "MalesBeliGrocery backend API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8000", "type": "string" }
  ],
  "item": [
    {
      "name": "Registration Flow",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/api/auth/register",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "register"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"first_name\": \"Budi\",\n  \"last_name\": \"Santoso\",\n  \"email\": \"budi@example.com\",\n  \"phone\": \"081234567890\",\n  \"referral_code\": \"\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Verify Email + Set Password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/api/auth/verify-email",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "verify-email"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"PASTE_TOKEN_FROM_EMAIL_HERE\",\n  \"password\": \"Password123\",\n  \"confirm_password\": \"Password123\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Resend Verification Email",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/api/auth/resend-verification",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "resend-verification"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"budi@example.com\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        }
      ]
    },
    {
      "name": "Login & Session",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Has cookie', () => pm.cookies.has('access_token'));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "login"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"budi@example.com\",\n  \"password\": \"Password123\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Get Me (Protected)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/auth/me",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "me"]
            }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/auth/logout",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "logout"]
            }
          }
        }
      ]
    },
    {
      "name": "Google OAuth",
      "item": [
        {
          "name": "Initiate Google Login (open in browser)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/auth/google",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "google"]
            },
            "description": "Open this URL in a browser — Postman cannot handle the OAuth redirect flow."
          }
        },
        {
          "name": "Complete Profile (Google new user)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/api/auth/complete-profile",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "complete-profile"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"081234567890\",\n  \"referral_code\": \"\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Call after Google OAuth for new users. Requires access_token cookie."
          }
        },
        {
          "name": "Setup Password (Google user — add email login)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/api/auth/setup-password",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "setup-password"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"password\": \"Password123\",\n  \"confirm_password\": \"Password123\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Only works when user has no password yet (OAuth-only account)."
          }
        }
      ]
    },
    {
      "name": "Reset Password",
      "item": [
        {
          "name": "Forgot Password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/api/auth/forgot-password",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "forgot-password"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"budi@example.com\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Reset Password (Confirm)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/api/auth/reset-password",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "reset-password"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"PASTE_TOKEN_FROM_EMAIL_HERE\",\n  \"new_password\": \"NewPassword123\",\n  \"confirm_password\": \"NewPassword123\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        }
      ]
    },
    {
      "name": "Stores",
      "item": [
        {
          "name": "Get Default Store (no location)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/stores",
              "host": ["{{base_url}}"],
              "path": ["api", "stores"]
            },
            "description": "Returns the default store (lowest ID) when no coordinates are provided. distance_km will be null."
          }
        },
        {
          "name": "Get Nearest Store (with location)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/stores?lat=-6.2&lng=106.8",
              "host": ["{{base_url}}"],
              "path": ["api", "stores"],
              "query": [
                {
                  "key": "lat",
                  "value": "-6.2",
                  "description": "User latitude (-90 to 90)"
                },
                {
                  "key": "lng",
                  "value": "106.8",
                  "description": "User longitude (-180 to 180)"
                }
              ]
            },
            "description": "Returns the nearest store to the given coordinates with a distance_km field."
          }
        },
        {
          "name": "Get Nearest Store — lat out of range",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/stores?lat=91&lng=106.8",
              "host": ["{{base_url}}"],
              "path": ["api", "stores"],
              "query": [
                { "key": "lat", "value": "91" },
                { "key": "lng", "value": "106.8" }
              ]
            },
            "description": "Expects 400 — lat must be >= -90 and <= 90."
          }
        },
        {
          "name": "Get Nearest Store — missing lng",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/stores?lat=-6.2",
              "host": ["{{base_url}}"],
              "path": ["api", "stores"],
              "query": [{ "key": "lat", "value": "-6.2" }]
            },
            "description": "Expects 400 — Provide both lat and lng, or neither."
          }
        }
      ]
    },
